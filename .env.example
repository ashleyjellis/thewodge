# Server storage (Turso/libSQL) — optional. v1 runs local-first without these.
# Provision a Turso DB in an EU region with encryption at rest before enabling.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_ENCRYPTION_KEY=

# Where the server-side email list is written in local dev (defaults to ./.data)
WODGE_DATA_DIR=
