# Logged-in experience database (Turso/libSQL) — required for src/server/db/*.
# Without these, the db client falls back to a local libSQL file (see
# WODGE_LOCAL_DB_PATH below) — no network required, used by tests and local dev.
# Provision the real Turso DB in an EU region with encryption at rest.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_ENCRYPTION_KEY=

# Local libSQL file used when TURSO_DATABASE_URL is unset. Defaults to
# .data/wodge-app.db (gitignored) if not set.
WODGE_LOCAL_DB_PATH=

# Set to 1 to force local file mode even when the Turso vars above are filled in
# — useful if you can't reach Turso's network but don't want to remove .env.
WODGE_FORCE_LOCAL_DB=

# Where the server-side email list is written in local dev (defaults to ./.data)
WODGE_DATA_DIR=

# Provider pricing archive database (Turso/libSQL) — a SEPARATE database from
# the vars above, required for src/server/archiveDb/*. Deliberately isolated
# from the household app's DB: an unattended scraper+LLM pipeline writes here
# on a schedule and must never share credentials or blast radius with real
# user financial data. Same local-file fallback pattern as above when unset.
ARCHIVE_TURSO_DATABASE_URL=
ARCHIVE_TURSO_AUTH_TOKEN=
ARCHIVE_TURSO_ENCRYPTION_KEY=

# Local libSQL file used when ARCHIVE_TURSO_DATABASE_URL is unset. Defaults to
# .data/wodge-archive.db (gitignored) if not set. The Python pipeline
# (pipeline/db.py) reads this same fallback, so one set of vars covers both.
ARCHIVE_LOCAL_DB_PATH=

# Set to 1 to force local file mode even when the archive Turso vars above are
# filled in — same escape hatch as WODGE_FORCE_LOCAL_DB.
ARCHIVE_FORCE_LOCAL_DB=

# Performance tracker database (Turso/libSQL) — a THIRD database, separate
# from both of the above. It holds fabricated demo data (fictional firms,
# invented performance) which must never sit alongside real archived pricing,
# and its schema defines its own `providers` table that would collide with the
# archive's. Same local-file fallback when unset.
TRACKER_TURSO_DATABASE_URL=
TRACKER_TURSO_AUTH_TOKEN=
TRACKER_TURSO_ENCRYPTION_KEY=

# Local libSQL file used when TRACKER_TURSO_DATABASE_URL is unset. Defaults to
# .data/wodge-tracker.db (gitignored) if not set.
TRACKER_LOCAL_DB_PATH=

# Set to 1 to force local file mode even when the tracker Turso vars above are
# filled in — same escape hatch as WODGE_FORCE_LOCAL_DB.
TRACKER_FORCE_LOCAL_DB=

# Demo mode for the performance tracker. ON unless explicitly set to 0,
# because the failure modes are not symmetric: a banner shown over real data
# is a small embarrassment, while fabricated performance figures published
# without one are a serious problem. Seeding refuses to run when this is off.
VITE_DEMO_MODE=
