{
  "name": "thewodge",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && node scripts/spa-shell.mjs && node scripts/seo.mjs",
    "start": "node .output/server/index.mjs",
    "serve": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "archive:db:generate": "drizzle-kit generate --config drizzle.archive.config.ts",
    "archive:db:migrate": "tsx scripts/archive-db-migrate.ts",
    "archive:db:studio": "drizzle-kit studio --config drizzle.archive.config.ts",
    "tracker:db:generate": "drizzle-kit generate --config drizzle.tracker.config.ts",
    "tracker:db:migrate": "tsx scripts/tracker-db-migrate.ts",
    "tracker:db:studio": "drizzle-kit studio --config drizzle.tracker.config.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.30",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.22",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.0"
}
